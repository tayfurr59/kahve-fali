import type { Photo } from './images'
import type { Settings } from './settings'
import { FALCI_SYSTEM_PROMPT, buildUserPrompt } from './prompt'

export interface ReadingRequest {
 photos: Photo[]
 name?: string
 age?: string
 status?: string
 focus?: string
}

function friendlyError(status: number, body: string): Error {
 if (status === 401 || status === 403) {
 return new Error('API anahtarı geçersiz veya yetkisiz. Ayarlardan anahtarını kontrol et.')
 }
 if (status === 429) {
 return new Error('Çok fazla istek gönderildi ya da kotan doldu. Biraz bekleyip tekrar dene.')
 }
 if (status >= 500) {
 return new Error('Servis şu anda yanıt vermiyor. Birkaç dakika sonra tekrar dene.')
 }
 if (status === 404) {
 let suggested = ''
 try {
 const msg = (JSON.parse(body) as { error?: { message?: string } }).error?.message ?? ''
 suggested = /models\/([\w.-]+) for the latest/.exec(msg)?.[1] ?? ''
 } catch {
 /* gövde JSON değilse öneri çıkarmayı atla */
 }
 return new Error(
 suggested
 ? `Seçtiğin model artık kullanılamıyor. Ayarlardan model adını "${suggested}" olarak güncelle.`
 : 'Seçtiğin model bulunamadı. Ayarlardan model adını kontrol et.',
 )
 }
 const snippet = body.slice(0, 300)
 return new Error(`İstek başarısız (${status}). ${snippet}`)
}

async function callGemini(req: ReadingRequest, s: Settings): Promise<string> {
 const model = s.geminiModel.trim() || 'AI 模型-3.6-flash'
 const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(
 model,
 )}:generateContent`

 const parts: unknown[] = [
 { text: buildUserPrompt(req) },
 ...req.photos.map((p) => ({
 inline_data: { mime_type: p.mimeType, data: p.base64 },
 })),
 ]

 const res = await fetch(url, {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json',
 'x-goog-api-key': s.geminiKey.trim(),
 },
 body: JSON.stringify({
 system_instruction: { parts: [{ text: FALCI_SYSTEM_PROMPT }] },
 contents: [{ role: 'user', parts }],
 generationConfig: { temperature: 0.85, maxOutputTokens: 4096 },
 }),
 })

 const text = await res.text()
 if (!res.ok) throw friendlyError(res.status, text)

 const json = JSON.parse(text) as {
 candidates?: { content?: { parts?: { text?: string }[] } }[]
 promptFeedback?: { blockReason?: string }
 }

 if (json.promptFeedback?.blockReason) {
 throw new Error('Görseller servis tarafından reddedildi. Farklı bir fotoğraf dene.')
 }

 const out = (json.candidates?.[0]?.content?.parts ?? [])
 .map((p) => p.text ?? '')
 .join('')
 .trim()

 if (!out) throw new Error('Boş yanıt geldi. Tekrar dene.')
 return out
}

async function callOpenAI(req: ReadingRequest, s: Settings): Promise<string> {
 const model = s.openaiModel.trim() || 'gpt-4o'

 const content: unknown[] = [
 { type: 'text', text: buildUserPrompt(req) },
 ...req.photos.map((p) => ({
 type: 'image_url',
 image_url: { url: p.dataUrl },
 })),
 ]

 const res = await fetch('https://api.openai.com/v1/chat/completions', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json',
 Authorization: `Bearer ${s.openaiKey.trim()}`,
 },
 body: JSON.stringify({
 model,
 temperature: 0.85,
 max_tokens: 3000,
 messages: [
 { role: 'system', content: FALCI_SYSTEM_PROMPT },
 { role: 'user', content },
 ],
 }),
 })

 const text = await res.text()
 if (!res.ok) throw friendlyError(res.status, text)

 const json = JSON.parse(text) as {
 choices?: { message?: { content?: string } }[]
 }
 const out = (json.choices?.[0]?.message?.content ?? '').trim()
 if (!out) throw new Error('Boş yanıt geldi. Tekrar dene.')
 return out
}

export async function readFortune(req: ReadingRequest, s: Settings): Promise<string> {
 return s.provider === 'gemini' ? callGemini(req, s) : callOpenAI(req, s)
}

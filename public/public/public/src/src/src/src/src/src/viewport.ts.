const MOVE_TOLERANCE = 12

type TapHandler = (ev: Event) => void

/**
 * Dokunma ve fare için tek giriş yolu: Pointer Events.
 * Kaydırma sırasında yanlışlıkla tetiklenmemesi için hareket eşiği uygular.
 */
export function onTap(el: Element, handler: TapHandler): void {
 if (typeof window.PointerEvent !== 'function') {
 el.addEventListener('click', handler)
 return
 }

 let startX = 0
 let startY = 0
 let tracking = false
 let pointerId = -1

 el.addEventListener('pointerdown', (raw) => {
 const ev = raw as PointerEvent
 if (ev.button !== 0 && ev.pointerType === 'mouse') return
 tracking = true
 pointerId = ev.pointerId
 startX = ev.clientX
 startY = ev.clientY
 })

 el.addEventListener('pointercancel', () => {
 tracking = false
 })

 el.addEventListener('pointerup', (raw) => {
 const ev = raw as PointerEvent
 if (!tracking || ev.pointerId !== pointerId) return
 tracking = false
 const moved = Math.hypot(ev.clientX - startX, ev.clientY - startY)
 if (moved > MOVE_TOLERANCE) return
 handler(ev)
 })
}

/**
 * Ekran döndürme ve yeniden boyutlandırmada düzeni tazeler.
 * Gerçek yüksekliği --vh olarak yazar, mobil tarayıcı adres çubuğu sorununu çözer.
 */
export function initViewport(onChange?: () => void): void {
 let frame = 0

 const apply = () => {
 cancelAnimationFrame(frame)
 frame = requestAnimationFrame(() => {
 const h = window.visualViewport?.height ?? window.innerHeight
 document.documentElement.style.setProperty('--vh', `${h * 0.01}px`)
 const portrait = h >= (window.visualViewport?.width ?? window.innerWidth)
 document.documentElement.dataset.orientation = portrait ? 'portrait' : 'landscape'
 onChange?.()
 })
 }

 window.addEventListener('resize', apply)
 window.addEventListener('orientationchange', apply)
 window.visualViewport?.addEventListener('resize', apply)
 screen.orientation?.addEventListener('change', apply)
 apply()
}

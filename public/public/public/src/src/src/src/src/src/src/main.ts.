import { preparePhoto, type Photo } from './images'
import { loadSettings, saveSettings, activeKey, type Settings } from './settings'
import { readFortune } from './api'
import { formatReading } from './format'
import { onTap, initViewport } from './viewport'

type Screen = 'home' | 'loading' | 'result'

interface SlotDef {
 key: 'cup1' | 'cup2' | 'plate'
 icon: string
 label: string
}

const SLOTS: SlotDef[] = [
 { key: 'cup1', icon: '☕', label: 'Fincan 1' },
 { key: 'cup2', icon: '☕', label: 'Fincan 2' },
 { key: 'plate', icon: '🍽️', label: 'Tabak' },
]

const app = document.querySelector<HTMLDivElement>('#app')!

const photos: Record<SlotDef['key'], Photo | null> = { cup1: null, cup2: null, plate: null }
let settings: Settings = loadSettings()
let screen: Screen = 'home'
let reading = ''
let errorMsg = ''
let sheetOpen = false
const form = { name: '', age: '', status: '', focus: '' }

const fileInput = document.createElement('input')
fileInput.type = 'file'
fileInput.accept = 'image/*'
fileInput.style.display = 'none'
document.body.appendChild(fileInput)
let pendingSlot: SlotDef['key'] | null = null

fileInput.addEventListener('change', async () => {
 const file = fileInput.files?.[0]
 const slot = pendingSlot
 fileInput.value = ''
 pendingSlot = null
 if (!file || !slot) return

 try {
 photos[slot] = await preparePhoto(file)
 errorMsg = ''
 } catch (e) {
 errorMsg = e instanceof Error ? e.message : 'Fotoğraf yüklenemedi.'
 }
 render()
})

function registerServiceWorker(): void {
 if (!('serviceWorker' in navigator)) return
 window.addEventListener('load', () => {
 void navigator.serviceWorker.register('/sw.js').catch(() => {
 /* çevrimdışı destek yoksa uygulama yine çalışır */
 })
 })
}

function pickPhoto(slot: SlotDef['key']): void {
 pendingSlot = slot
 fileInput.click()
}

function allPhotosReady(): boolean {
 return SLOTS.every((s) => photos[s.key] !== null)
}

async function submitReading(): Promise<void> {
 if (!allPhotosReady()) {
 errorMsg = 'Falın okunabilmesi için iki fincan ve bir tabak fotoğrafı gerekiyor.'
 render()
 return
 }
 if (!activeKey(settings)) {
 errorMsg = 'Önce ayarlardan API anahtarını gir.'
 sheetOpen = true
 render()
 return
 }

 errorMsg = ''
 screen = 'loading'
 render()

 try {
 reading = await readFortune(
 {
 photos: [photos.cup1!, photos.cup2!, photos.plate!],
 name: form.name,
 age: form.age,
 status: form.status,
 focus: form.focus,
 },
 settings,
 )
 screen = 'result'
 } catch (e) {
 errorMsg = e instanceof Error ? e.message : 'Fal okunurken bir hata oluştu.'
 screen = 'home'
 }
 render()
}

function resetAll(): void {
 photos.cup1 = null
 photos.cup2 = null
 photos.plate = null
 reading = ''
 errorMsg = ''
 screen = 'home'
 render()
}

function slotHtml(def: SlotDef): string {
 const p = photos[def.key]
 const filled = p ? ' filled' : ''
 const inner = p
 ? `<img src="${p.dataUrl}" alt="${def.label}" /><button class="clear" data-clear="${def.key}" aria-label="Kaldır">✕</button>`
 : `<span class="ph"><span class="ico">${def.icon}</span><span class="lbl">${def.label}</span></span>`
 return `<div class="slot${filled}" data-slot="${def.key}" role="button" tabindex="0">${inner}</div>`
}

function homeHtml(): string {
 const ready = allPhotosReady()
 return `
 <div class="card">
 <h2>Fotoğrafları ekle</h2>
 <p class="hint">Fincanın içini iki farklı açıdan, tabağı ise tortu görünecek şekilde çek. Işık iyi olsun, fotoğraf net olsun.</p>
 <div class="slots">${SLOTS.map(slotHtml).join('')}</div>
 </div>

 <div class="card">
 <h2>Fal sahibi (isteğe bağlı)</h2>
 <p class="hint">Bu bilgiler sadece bağlam için kullanılır, yorum yine sadece şekillere dayanır.</p>
 <div class="row">
 <div class="field">
 <label for="f-name">İsim</label>
 <input id="f-name" data-form="name" type="text" value="${form.name}" placeholder="Adın" />
 </div>
 <div class="field">
 <label for="f-age">Yaş</label>
 <input id="f-age" data-form="age" type="number" inputmode="numeric" value="${form.age}" placeholder="28" />
 </div>
 </div>
 <div class="field">
 <label for="f-status">İlişki durumu</label>
 <select id="f-status" data-form="status">
 <option value=""${form.status === '' ? ' selected' : ''}>Belirtmek istemiyorum</option>
 <option value="Bekar"${form.status === 'Bekar' ? ' selected' : ''}>Bekar</option>
 <option value="İlişkisi var"${form.status === 'İlişkisi var' ? ' selected' : ''}>İlişkim var</option>
 <option value="Nişanlı"${form.status === 'Nişanlı' ? ' selected' : ''}>Nişanlı</option>
 <option value="Evli"${form.status === 'Evli' ? ' selected' : ''}>Evli</option>
 <option value="Ayrılık sürecinde"${form.status === 'Ayrılık sürecinde' ? ' selected' : ''}>Ayrılık sürecinde</option>
 </select>
 </div>
 <div class="field">
 <label for="f-focus">Merak ettiğin konu</label>
 <input id="f-focus" data-form="focus" type="text" value="${form.focus}" placeholder="Aşk, iş, yol, para..." />
 </div>
 </div>

 <button class="btn" id="read-btn"${ready ? '' : ' disabled'}>Falımı Oku</button>
 <p class="note">${ready ? 'Fincan hazır, tortu konuşmaya başlıyor.' : 'Üç fotoğrafı da ekleyince düğme aktif olur.'}</p>
 ${errorMsg ? `<div class="msg err">${errorMsg}</div>` : ''}
 <p class="disclaimer">Eğlence amaçlıdır. Kararlarını fala göre verme.</p>
 `
}

function loadingHtml(): string {
 return `
 <div class="card loading">
 <div class="steam">☕</div>
 <p>Fincan okunuyor, tortu takip ediliyor...</p>
 <p>Bu biraz sürebilir, sayfayı kapatma.</p>
 </div>
 `
}

function resultHtml(): string {
 const thumbs = SLOTS.map((s) => {
 const p = photos[s.key]
 return p ? `<img src="${p.dataUrl}" alt="${s.label}" />` : ''
 }).join('')

 return `
 <div class="card">
 <h2>Falın hazır</h2>
 <div class="thumbs">${thumbs}</div>
 <div class="reading">${formatReading(reading)}</div>
 </div>
 <button class="btn ghost" id="copy-btn">Yorumu Kopyala</button>
 <div style="height:10px"></div>
 <button class="btn" id="again-btn">Yeni Fal</button>
 <p class="disclaimer">Eğlence amaçlıdır. Kararlarını fala göre verme.</p>
 `
}

function sheetHtml(): string {
 const isGemini = settings.provider === 'AI 模型'
 return `
 <div class="sheet${sheetOpen ? ' open' : ''}" id="sheet">
 <div class="sheet-inner" id="sheet-inner">
 <h2>Ayarlar</h2>
 <p class="hint">Anahtarın sadece bu cihazın hafızasında saklanır, hiçbir sunucuya gönderilmez.</p>
 <div class="field">
 <label for="s-provider">Servis</label>
 <select id="s-provider">
 <option value="AI 模型"${isGemini ? ' selected' : ''}>Google AI 模型</option>
 <option value="openai"${!isGemini ? ' selected' : ''}>OpenAI</option>
 </select>
 </div>
 <div class="field${isGemini ? '' : ' hidden'}">
 <label for="s-AI 模型-key">AI 模型 API anahtarı</label>
 <input id="s-AI 模型-key" type="password" value="${settings.geminiKey}" placeholder="AIza..." />
 </div>
 <div class="field${isAI 模型 ? '' : ' hidden'}">
 <label for="s-AI 模型-model">Gemini modeli</label>
 <input id="s-AI 模型-model" type="text" value="${settings.geminiModel}" placeholder="AI 模型-3.6-flash" />
 </div>
 <div class="field${isAI 模型 ? ' hidden' : ''}">
 <label for="s-openai-key">OpenAI API anahtarı</label>
 <input id="s-openai-key" type="password" value="${settings.openaiKey}" placeholder="sk-..." />
 </div>
 <div class="field${isGemini ? ' hidden' : ''}">
 <label for="s-openai-model">OpenAI modeli</label>
 <input id="s-openai-model" type="text" value="${settings.openaiModel}" placeholder="gpt-4o" />
 </div>
 <button class="btn" id="save-settings">Kaydet</button>
 <div style="height:10px"></div>
 <button class="btn ghost" id="close-settings">Kapat</button>
 </div>
 </div>
 `
}

function render(): void {
 const body =
 screen === 'home' ? homeHtml() : screen === 'loading' ? loadingHtml() : resultHtml()

 app.innerHTML = `
 <div class="topbar">
 <div class="brand">
 <span class="cup">☕</span>
 <div>
 <h1>Kahve Falı</h1>
 <p>Geleneksel sembol okuması</p>
 </div>
 </div>
 <button class="icon-btn" id="settings-btn" aria-label="Ayarlar">⚙</button>
 </div>
 ${body}
 ${sheetHtml()}
 `
 bind()
}

function bind(): void {
 const settingsBtn = app.querySelector('#settings-btn')
 if (settingsBtn) {
 onTap(settingsBtn, () => {
 sheetOpen = true
 render()
 })
 }

 app.querySelectorAll<HTMLElement>('[data-slot]').forEach((el) => {
 const key = el.dataset.slot as SlotDef['key']
 onTap(el, (ev) => {
 if ((ev.target as HTMLElement).dataset.clear) return
 pickPhoto(key)
 })
 })

 app.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((el) => {
 onTap(el, (ev) => {
 ev.stopPropagation()
 photos[el.dataset.clear as SlotDef['key']] = null
 render()
 })
 })

 app.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-form]').forEach((el) => {
 const field = el.dataset.form as keyof typeof form
 el.addEventListener('input', () => {
 form[field] = el.value
 })
 el.addEventListener('change', () => {
 form[field] = el.value
 })
 })

 const readBtn = app.querySelector('#read-btn')
 if (readBtn) {
 onTap(readBtn, () => {
 void submitReading()
 })
 }

 const againBtn = app.querySelector('#again-btn')
 if (againBtn) onTap(againBtn, resetAll)

 const copyBtn = app.querySelector<HTMLButtonElement>('#copy-btn')
 if (copyBtn) {
 onTap(copyBtn, () => {
 void navigator.clipboard
 .writeText(reading)
 .then(() => {
 copyBtn.textContent = 'Kopyalandı'
 window.setTimeout(() => {
 copyBtn.textContent = 'Yorumu Kopyala'
 }, 1600)
 })
 .catch(() => {
 /* pano erişimi yoksa sessizce geç */
 })
 })
 }

 const providerSel = app.querySelector<HTMLSelectElement>('#s-provider')
 providerSel?.addEventListener('change', () => {
 settings = { ...settings, provider: providerSel.value as Settings['provider'] }
 saveSettings(settings)
 render()
 })

 const saveBtn = app.querySelector('#save-settings')
 if (saveBtn) {
 onTap(saveBtn, () => {
 settings = {
 ...settings,
 geminiKey: app.querySelector<HTMLInputElement>('#s-AI 模型-key')?.value.trim() ?? '',
 geminiModel: app.querySelector<HTMLInputElement>('#s-gemini-model')?.value.trim() ?? '',
 openaiKey: app.querySelector<HTMLInputElement>('#s-openai-key')?.value.trim() ?? '',
 openaiModel: app.querySelector<HTMLInputElement>('#s-openai-model')?.value.trim() ?? '',
 }
 saveSettings(settings)
 sheetOpen = false
 errorMsg = ''
 render()
 })
 }

 const closeBtn = app.querySelector('#close-settings')
 if (closeBtn) {
 onTap(closeBtn, () => {
 sheetOpen = false
 render()
 })
 }

 const sheet = app.querySelector('#sheet')
 if (sheet) {
 onTap(sheet, (ev) => {
 if (ev.target === sheet) {
 sheetOpen = false
 render()
 }
 })
 }
}

initViewport()
render()
registerServiceWorker()

function escapeHtml(s: string): string {
 return s
 .replace(/&/g, '&amp;')
 .replace(/</g, '&lt;')
 .replace(/>/g, '&gt;')
 .replace(/"/g, '&quot;')
}

const HEADING_RE = /^\s*(?:\*\*)?\s*(\d{1,2})\s*[)\].:-]\s*(.+?)\s*(?:\*\*)?\s*$/
const BULLET_RE = /^\s*[-*•]\s+(.*)$/

function inline(s: string): string {
 return escapeHtml(s)
 .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
 .replace(/(^|\s)\*(?!\s)(.+?)\*(?=\s|$)/g, '$1<em>$2</em>')
}

/** Modelin döndürdüğü düz metni okunabilir HTML'e çevirir. */
export function formatReading(raw: string): string {
 const lines = raw.replace(/\r\n/g, '\n').split('\n')
 const out: string[] = []
 let listOpen = false
 let paragraph: string[] = []

 const flushParagraph = () => {
 if (paragraph.length > 0) {
 out.push(`<p>${inline(paragraph.join(' '))}</p>`)
 paragraph = []
 }
 }
 const closeList = () => {
 if (listOpen) {
 out.push('</ul>')
 listOpen = false
 }
 }

 for (const line of lines) {
 const trimmed = line.trim()

 if (trimmed === '') {
 flushParagraph()
 closeList()
 continue
 }

 const heading = HEADING_RE.exec(trimmed)
 if (heading && Number(heading[1]) >= 1 && Number(heading[1]) <= 10) {
 flushParagraph()
 closeList()
 out.push(`<h3>${inline(`${heading[1]}) ${heading[2]}`)}</h3>`)
 continue
 }

 const bullet = BULLET_RE.exec(trimmed)
 if (bullet) {
 flushParagraph()
 if (!listOpen) {
 out.push('<ul>')
 listOpen = true
 }
 out.push(`<li>${inline(bullet[1])}</li>`)
 continue
 }

 closeList()
 paragraph.push(trimmed)
 }

 flushParagraph()
 closeList()
 return out.join('\n')
}

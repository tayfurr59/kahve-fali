export interface Photo {
 dataUrl: string
 mimeType: string
 base64: string
}

const MAX_SIDE = 1024
const JPEG_QUALITY = 0.85

function readAsDataUrl(file: File): Promise<string> {
 return new Promise((resolve, reject) => {
 const reader = new FileReader()
 reader.onload = () => resolve(String(reader.result))
 reader.onerror = () => reject(new Error('Dosya okunamadı.'))
 reader.readAsDataURL(file)
 })
}

function loadImage(src: string): Promise<HTMLImageElement> {
 return new Promise((resolve, reject) => {
 const img = new Image()
 img.onload = () => resolve(img)
 img.onerror = () => reject(new Error('Görsel yüklenemedi.'))
 img.src = src
 })
}

/** Fotoğrafı en uzun kenarı MAX_SIDE olacak şekilde küçültüp JPEG'e çevirir. */
export async function preparePhoto(file: File): Promise<Photo> {
 if (!file.type.startsWith('image/')) {
 throw new Error('Lütfen bir fotoğraf seçin.')
 }

 const original = await readAsDataUrl(file)
 const img = await loadImage(original)

 const scale = Math.min(1, MAX_SIDE / Math.max(img.naturalWidth, img.naturalHeight))
 const w = Math.max(1, Math.round(img.naturalWidth * scale))
 const h = Math.max(1, Math.round(img.naturalHeight * scale))

 const canvas = document.createElement('canvas')
 canvas.width = w
 canvas.height = h
 const ctx = canvas.getContext('2d')
 if (!ctx) throw new Error('Görsel işlenemedi.')
 ctx.drawImage(img, 0, 0, w, h)

 const dataUrl = canvas.toDataURL('image/jpeg', JPEG_QUALITY)
 const base64 = dataUrl.slice(dataUrl.indexOf(',') + 1)

 return { dataUrl, mimeType: 'image/jpeg', base64 }
}

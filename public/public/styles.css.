:root {
 --bg: #1b1109;
 --bg-2: #2a1a10;
 --card: rgba(255, 248, 235, 0.06);
 --line: rgba(226, 189, 122, 0.28);
 --gold: #e2bd7a;
 --gold-soft: #c9a35c;
 --text: #f4ead9;
 --muted: #b9a68c;
 --danger: #e07a5f;
 --ok: #7ec08a;
}

* {
 box-sizing: border-box;
 -webkit-tap-highlight-color: transparent;
}

html,
body {
 margin: 0;
 padding: 0;
 min-height: 100%;
 background: var(--bg);
 color: var(--text);
 font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
 font-size: 16px;
 line-height: 1.6;
}

body {
 background:
 radial-gradient(1200px 600px at 50% -10%, #4a2e1a 0%, transparent 60%),
 radial-gradient(800px 500px at 100% 100%, #33200f 0%, transparent 55%),
 var(--bg);
}

#app {
 max-width: 560px;
 margin: 0 auto;
 padding: max(16px, env(safe-area-inset-top)) 16px calc(24px + env(safe-area-inset-bottom));
}

.topbar {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 padding: 6px 0 14px;
}

.brand {
 display: flex;
 align-items: center;
 gap: 10px;
 min-width: 0;
}

.brand .cup {
 font-size: 26px;
 line-height: 1;
}

.brand h1 {
 margin: 0;
 font-size: 19px;
 font-weight: 700;
 letter-spacing: 0.3px;
 color: var(--gold);
 white-space: nowrap;
}

.brand p {
 margin: 0;
 font-size: 12px;
 color: var(--muted);
}

.icon-btn {
 flex: 0 0 auto;
 width: 42px;
 height: 42px;
 border-radius: 12px;
 border: 1px solid var(--line);
 background: var(--card);
 color: var(--gold);
 font-size: 19px;
 display: grid;
 place-items: center;
 cursor: pointer;
}

.icon-btn:active {
 transform: scale(0.96);
}

.card {
 border: 1px solid var(--line);
 background: var(--card);
 border-radius: 18px;
 padding: 16px;
 margin-bottom: 14px;
 backdrop-filter: blur(6px);
}

.card h2 {
 margin: 0 0 4px;
 font-size: 15px;
 color: var(--gold);
 font-weight: 700;
}

.card .hint {
 margin: 0 0 14px;
 font-size: 12.5px;
 color: var(--muted);
}

.slots {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: 10px;
}

.slot {
 position: relative;
 aspect-ratio: 3 / 4;
 border-radius: 14px;
 border: 1.5px dashed var(--line);
 background: rgba(0, 0, 0, 0.22);
 display: grid;
 place-items: center;
 overflow: hidden;
 cursor: pointer;
 transition: border-color 0.18s ease;
}

.slot.filled {
 border-style: solid;
 border-color: var(--gold-soft);
}

.slot img {
 position: absolute;
 inset: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
}

.slot .ph {
 text-align: center;
 padding: 6px;
 pointer-events: none;
}

.slot .ph .ico {
 font-size: 24px;
 display: block;
 margin-bottom: 4px;
}

.slot .ph .lbl {
 font-size: 11.5px;
 color: var(--muted);
 display: block;
}

.slot .clear {
 position: absolute;
 top: 6px;
 right: 6px;
 width: 26px;
 height: 26px;
 border-radius: 50%;
 border: none;
 background: rgba(0, 0, 0, 0.6);
 color: #fff;
 font-size: 14px;
 display: none;
 place-items: center;
 cursor: pointer;
}

.slot.filled .clear {
 display: grid;
}

.field {
 margin-bottom: 12px;
}

.field label {
 display: block;
 font-size: 12.5px;
 color: var(--muted);
 margin-bottom: 6px;
}

.field input,
.field select,
.field textarea {
 width: 100%;
 padding: 12px 13px;
 border-radius: 12px;
 border: 1px solid var(--line);
 background: rgba(0, 0, 0, 0.3);
 color: var(--text);
 font-size: 15px;
 font-family: inherit;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
 outline: none;
 border-color: var(--gold-soft);
}

.row {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 10px;
}

.btn {
 width: 100%;
 padding: 16px 18px;
 border-radius: 16px;
 border: none;
 background: linear-gradient(135deg, #e2bd7a, #b8873f);
 color: #2a1a0c;
 font-size: 17px;
 font-weight: 800;
 letter-spacing: 0.3px;
 cursor: pointer;
 box-shadow: 0 10px 24px rgba(184, 135, 63, 0.25);
}

.btn:disabled {
 opacity: 0.45;
 box-shadow: none;
 cursor: not-allowed;
}

.btn:not(:disabled):active {
 transform: translateY(1px);
}

.btn.ghost {
 background: transparent;
 border: 1px solid var(--line);
 color: var(--gold);
 box-shadow: none;
 font-weight: 700;
 font-size: 15px;
 padding: 13px 16px;
}

.note {
 font-size: 12px;
 color: var(--muted);
 text-align: center;
 margin: 10px 2px 0;
}

.msg {
 margin-top: 12px;
 padding: 12px 14px;
 border-radius: 12px;
 font-size: 13.5px;
 border: 1px solid;
}

.msg.err {
 border-color: rgba(224, 122, 95, 0.5);
 background: rgba(224, 122, 95, 0.12);
 color: #f3b8a6;
}

.msg.ok {
 border-color: rgba(126, 192, 138, 0.45);
 background: rgba(126, 192, 138, 0.1);
 color: #bfe2c6;
}

.loading {
 display: grid;
 place-items: center;
 gap: 14px;
 padding: 34px 10px;
 text-align: center;
}

.steam {
 font-size: 46px;
 animation: float 2.4s ease-in-out infinite;
}

@keyframes float {
 0%,
 100% {
 transform: translateY(0) rotate(-3deg);
 }
 50% {
 transform: translateY(-8px) rotate(3deg);
 }
}

.loading p {
 margin: 0;
 color: var(--muted);
 font-size: 14px;
}

.reading {
 white-space: pre-wrap;
 font-size: 15.5px;
 line-height: 1.75;
}

.reading h3 {
 margin: 20px 0 6px;
 font-size: 15px;
 color: var(--gold);
 letter-spacing: 0.2px;
}

.reading h3:first-child {
 margin-top: 0;
}

.reading p {
 margin: 0 0 10px;
}

.reading li {
 margin-bottom: 6px;
}

.reading ul {
 padding-left: 20px;
 margin: 0 0 10px;
}

.thumbs {
 display: flex;
 gap: 8px;
 margin-bottom: 14px;
}

.thumbs img {
 width: 64px;
 height: 84px;
 object-fit: cover;
 border-radius: 10px;
 border: 1px solid var(--line);
}

.sheet {
 position: fixed;
 inset: 0;
 background: rgba(0, 0, 0, 0.6);
 display: none;
 align-items: flex-end;
 z-index: 40;
}

.sheet.open {
 display: flex;
}

.sheet-inner {
 width: 100%;
 max-width: 560px;
 margin: 0 auto;
 background: var(--bg-2);
 border-radius: 22px 22px 0 0;
 border-top: 1px solid var(--line);
 padding: 18px 16px calc(20px + env(safe-area-inset-bottom));
 max-height: 88vh;
 overflow-y: auto;
}

.sheet-inner h2 {
 margin: 0 0 4px;
 font-size: 17px;
 color: var(--gold);
}

.disclaimer {
 font-size: 11.5px;
 color: var(--muted);
 text-align: center;
 margin-top: 18px;
 opacity: 0.85;
}

.hidden {
 display: none !important;
}

@media (max-width: 360px) {
 body {
 font-size: 15px;
 }

 #app {
 padding-left: 12px;
 padding-right: 12px;
 }

 .brand h1 {
 font-size: 17px;
 }

 .slots {
 gap: 8px;
 }

 .slot .ph .ico {
 font-size: 20px;
 }

 .btn {
 font-size: 16px;
 padding: 15px 16px;
 }
}

@media (orientation: portrait) {
 #app {
 min-height: calc(var(--vh, 1vh) * 100);
 }

 .slot {
 aspect-ratio: 3 / 4;
 }
}

@media (orientation: landscape) {
 #app {
 max-width: 900px;
 }

 .slot {
 aspect-ratio: 4 / 3;
 }

 .sheet-inner {
 max-width: 900px;
 max-height: 94vh;
 }

 .steam {
 font-size: 38px;
 }

 .loading {
 padding: 22px 10px;
 }
}

@media (orientation: landscape) and (max-height: 480px) {
 .card {
 padding: 12px;
 margin-bottom: 10px;
 }

 .topbar {
 padding-bottom: 10px;
 }

 .card .hint {
 margin-bottom: 10px;
 }

 .btn {
 padding: 13px 16px;
 }
}

@media (min-width: 720px) {
 #app {
 max-width: 680px;
 padding-top: 24px;
 }

 .slots {
 gap: 14px;
 }

 .thumbs img {
 width: 84px;
 height: 108px;
 }

 .icon-btn:hover {
 border-color: var(--gold-soft);
 }
}

@media (pointer: coarse) {
 .icon-btn {
 width: 46px;
 height: 46px;
 }

 .slot .clear {
 width: 32px;
 height: 32px;
 font-size: 16px;
 }

 .field input,
 .field select {
 padding: 14px 13px;
 }
}

@media (prefers-reduced-motion: reduce) {
 .steam {
 animation: none;
 }
}
